# ==============================================================================
# AI-Powered Placement Coach - Backend Environment Configuration
# ==============================================================================

PROJECT_NAME="AI-Powered Placement Coach"
VERSION="1.0.0"
LOG_LEVEL="INFO"

# Database: SQLite for local zero-setup dev, or PostgreSQL for production
DATABASE_URL="sqlite+aiosqlite:///./placement.db"
# Example PostgreSQL URL: postgresql+asyncpg://postgres:postgres@localhost:5432/placement

# JWT & Security (min 32 characters random secret)
SECRET_KEY="replace-with-a-secure-random-32-byte-hex-secret-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
SECURE_COOKIES=False

# Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# AI Provider Configuration (100% Free Tier or Local Offline)
# Options: "gemini" (Google AI Studio free tier), "groq" (Groq cloud free), "ollama" (local offline)
AI_PROVIDER="gemini"

# Google AI Studio Free API Key (Get free key from https://aistudio.google.com/ - No credit card required)
GEMINI_API_KEY=""
AI_MODEL_CHAT="gemini-1.5-flash"
AI_MODEL_ANALYSIS="gemini-1.5-flash"

# Optional Groq Free Key (https://console.groq.com/ - No credit card required)
GROQ_API_KEY=""

# Optional Local Ollama Base URL (Run `ollama serve` and `ollama run llama3.2`)
OLLAMA_BASE_URL="http://localhost:11434"

# Resume Storage (Local filesystem in dev)
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=5

